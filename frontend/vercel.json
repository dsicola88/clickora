{
  "headers": [
    {
      "source": "/sw-push.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/l/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/robots-tenant.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/robots-marketing.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://clickora-production.up.railway.app/api/$1"
    },
    {
      "source": "/l/:id",
      "destination": "https://clickora-production.up.railway.app/api/public/presells/id/:id/html"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "www.dclickora.com" }],
      "destination": "/robots-marketing.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "dclickora.com" }],
      "destination": "/robots-marketing.txt"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(?<h>.*)\\.vercel\\.app" }],
      "destination": "/robots-marketing.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots-tenant.txt"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
